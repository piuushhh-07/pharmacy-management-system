# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/medicore

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
